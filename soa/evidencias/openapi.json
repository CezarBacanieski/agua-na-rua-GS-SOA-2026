  "info": {
    "title": "Água na Rua - API SOA",
    "description": "CitizenTech para consultar pontos acompanhados e registrar observações manuais. Dados de demonstração são identificados como simulados. Não fornece previsão de enchentes nem garantia de passagem segura.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ProblemaDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Entrada inválida"
          },
          "status": {
            "type": "number",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "Verifique os campos informados."
          },
          "instance": {
            "type": "string",
            "example": "/pontos"
          },
          "code": {
            "type": "string",
            "example": "ENTRADA_INVALIDA",
            "description": "Código estável da falha; respostas 422 usam o código da regra violada."
          },
          "errors": {
            "example": [
              "nome must be a string"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ]
      },
      "CadastroPontoDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Ponto de demonstração D",
            "maxLength": 100
          },
          "cidade": {
            "type": "string",
            "example": "São Paulo",
            "maxLength": 80
          },
          "bairro": {
            "type": "string",
            "example": "Jardim Peri",
            "maxLength": 80
          },
          "referenciaLocal": {
            "type": "string",
            "example": "Referência fictícia para demonstração",
            "maxLength": 160
          },
          "latitude": {
            "type": "number",
            "example": -23.463,
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "example": -46.663,
            "minimum": -180,
            "maximum": 180
          },
          "dadosSimulados": {
            "type": "boolean",
            "example": true,
            "description": "Obrigatório identificar dados de demonstração."
          }
        },
        "required": [
          "nome",
          "cidade",
          "bairro",
          "referenciaLocal",
          "latitude",
          "longitude",
          "dadosSimulados"
        ]
      },
      "PontoSaidaDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Ponto de demonstração D",
            "maxLength": 100
          },
          "cidade": {
            "type": "string",
            "example": "São Paulo",
            "maxLength": 80
          },
          "bairro": {
            "type": "string",
            "example": "Jardim Peri",
            "maxLength": 80
          },
          "referenciaLocal": {
            "type": "string",
            "example": "Referência fictícia para demonstração",
            "maxLength": 160
          },
          "latitude": {
            "type": "number",
            "example": -23.463,
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "example": -46.663,
            "minimum": -180,
            "maximum": 180
          },
          "dadosSimulados": {
            "type": "boolean",
            "example": true,
            "description": "Obrigatório identificar dados de demonstração."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "11111111-1111-4111-8111-111111111111"
          },
          "criadoEm": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-01T12:00:00.000Z"
          }
        },
        "required": [
          "nome",
          "cidade",
          "bairro",
          "referenciaLocal",
          "latitude",
          "longitude",
          "dadosSimulados",
          "id",
          "criadoEm"
        ]
      },
      "PaginaPontosDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "example": 3
          },
          "pagina": {
            "type": "number",
            "example": 1
          },
          "tamanho": {
            "type": "number",
            "example": 20
          },
          "totalPaginas": {
            "type": "number",
            "example": 1
          },
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PontoSaidaDto"
            }
          }
        },
        "required": [
          "total",
          "pagina",
          "tamanho",
          "totalPaginas",
          "itens"
        ]
      },
      "ObservacaoSaidaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1"
          },
          "pontoId": {
            "type": "string",
            "format": "uuid",
            "example": "11111111-1111-4111-8111-111111111111"
          },
          "condicaoRelatada": {
            "type": "string",
            "enum": [
              "SEM_AGUA_APARENTE",
              "AGUA_ACUMULADA",
              "ALAGAMENTO_RELATADO"
            ],
            "example": "AGUA_ACUMULADA"
          },
          "observadoEm": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-01T12:00:00.000Z"
          },
          "registradoEm": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-01T12:01:00.000Z"
          },
          "origem": {
            "type": "string",
            "enum": [
              "RELATO_MANUAL"
            ],
            "example": "RELATO_MANUAL",
            "description": "Atribuída pelo servidor; não comprova verificação do relato."
          },
          "dadosSimulados": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "pontoId",
          "condicaoRelatada",
          "observadoEm",
          "registradoEm",
          "origem",
          "dadosSimulados"
        ]
      },
      "ResumoSaidaDto": {
        "type": "object",
        "properties": {
          "pontoId": {
            "type": "string",
            "format": "uuid",
            "example": "11111111-1111-4111-8111-111111111111"
          },
          "atualizacao": {
            "type": "string",
            "enum": [
              "RECENTE",
              "ANTIGA",
              "SEM_INFORMACAO"
            ],
            "example": "SEM_INFORMACAO"
          },
          "ultimaObservacao": {
            "nullable": true,
            "description": "null quando o ponto não tem observações.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ObservacaoSaidaDto"
              }
            ]
          },
          "consultadoEm": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-11T12:00:00.000Z"
          },
          "janelaRecenteMinutos": {
            "type": "number",
            "example": 30,
            "description": "Parâmetro de demonstração configurável; sem validação operacional."
          },
          "aviso": {
            "type": "string",
            "example": "Relatos não comprovam segurança para passagem. Ausência de informação não indica rua livre."
          }
        },
        "required": [
          "pontoId",
          "atualizacao",
          "ultimaObservacao",
          "consultadoEm",
          "janelaRecenteMinutos",
          "aviso"
        ]
      },
      "NovaObservacaoDto": {
        "type": "object",
        "properties": {
          "condicaoRelatada": {
            "type": "string",
            "enum": [
              "SEM_AGUA_APARENTE",
              "AGUA_ACUMULADA",
              "ALAGAMENTO_RELATADO"
            ],
            "example": "AGUA_ACUMULADA"
          },
          "observadoEm": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-11T09:00:00-03:00",
            "description": "Instante observado com Z ou deslocamento explícito. Não pode estar no futuro."
          },
          "dadosSimulados": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "condicaoRelatada",
          "observadoEm",
          "dadosSimulados"
        ]
      },
      "PaginaObservacoesDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "example": 3
          },
          "pagina": {
            "type": "number",
            "example": 1
          },
          "tamanho": {
            "type": "number",
            "example": 20
          },
          "totalPaginas": {
            "type": "number",
            "example": 1
          },
          "itens": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ObservacaoSaidaDto"
            }
          }
        },
        "required": [
          "total",
          "pagina",
          "tamanho",
          "totalPaginas",
          "itens"
        ]
      },
      "SaudeDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "banco": {
            "type": "string",
            "example": "PostgreSQL"
          }
        },
        "required": [
          "status",
          "banco"
        ]
      }
    }
  }
}
