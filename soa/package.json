{
  "name": "agua-na-rua-soa",
  "version": "1.0.0",
  "private": true,
  "description": "Backend da CitizenTech Água na Rua - FIAP GS 2026.2",
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "scripts": {
    "setup": "node scripts/preparar-ambiente.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose stop db",
    "db:init": "npm run db:up && npm run migration:run",
    "migration:run": "npm run build && typeorm migration:run -d dist/infraestrutura/data-source.js",
    "migration:show": "npm run build && typeorm migration:show -d dist/infraestrutura/data-source.js",
    "migration:check": "npm run build && typeorm migration:generate -d dist/infraestrutura/data-source.js src/migrations/VerificaEsquema --check",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/infraestrutura/data-source.js",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/infraestrutura/data-source.ts",
    "test": "node scripts/testar.mjs",
    "test:unit": "jest --runInBand tests/unidade",
    "test:coverage": "node scripts/testar.mjs --coverage",
    "evidencias": "node scripts/capturar-evidencias.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/swagger": "11.4.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.10",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "playwright": "1.65.0",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
