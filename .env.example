# Execute npm run setup para gerar .env com senha aleatória local.
# Se copiar este arquivo manualmente, substitua a senha abaixo antes de subir.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=agua_na_rua
DB_USER=agua_app
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL
TEST_DB_PORT=55433
PORT=3000
# Hipótese do protótipo, ainda sem validação com moradores.
JANELA_RECENTE_MINUTOS=30
# Só necessário se um frontend web consumir a API pelo navegador.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
